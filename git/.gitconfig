[user]
	  name = Leonardo Lagos
    email = lagoslopezleonardo@gmail.com
	  signingkey = 0D06886B74ED962C
[commit]
    gpgsign = true
[color]
    ui = auto
[init]
    defaultBranch = main
[push]
    autoSetupRemote = true
[credential]
	  helper = cache --timeout=3600
[core]
	  pager = delta
[interactive]
	  diffFilter = delta --color-only
[delta]
	  navigate = true
	  light = false
[merge]
	  conflictstyle = zdiff3
