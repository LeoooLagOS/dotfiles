\documentclass[twocolumn,10pt,letterpaper]{article}

% --- 1. PANDOC 3.x CITATION INFRASTRUCTURE (Ghost Fix) ---
\makeatletter
\providecommand{\citeproctext}{}
\providecommand{\citeproc}[2]{\begingroup\def\citeproctext{#2}\cite{#1}\endgroup}
\providecommand{\citeprocverticalspacing}{|}
\providecommand{\citeproclayout}[1]{#1}
\makeatother

\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}

\newenvironment{CSLReferences}[2] % #1 hanging-indent, #2 entry-spacing
 {\begin{list}{}{%
  \setlength{\itemindent}{0pt}
  \setlength{\leftmargin}{0pt}
  \setlength{\parsep}{0pt}
  \ifodd #1
   \setlength{\leftmargin}{\cslhangindent}
   \setlength{\itemindent}{-1\cslhangindent}
  \fi
  \setlength{\itemsep}{#2\baselineskip}}}
 {\end{list}}

\newcommand{\CSLBlock}[1]{#1\hfill\break}

% FIX 1: Phantom [] bracket fix.
% \ifx\relax#1\relax does NOT catch empty strings — only \relax tokens.
% \ifx&#1& correctly detects a truly empty argument in LaTeX2e.
\newcommand{\CSLLeftMargin}[1]{\ifx&#1&\else\parbox[t]{\csllabelwidth}{#1}\fi}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{#1}\break}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}

% --- 2. CORE MATH & TABLE INFRASTRUCTURE ---
\usepackage{calc}        
\usepackage{array}       
\usepackage{longtable}   
\usepackage{booktabs}    
\usepackage{amssymb,amsmath}
\usepackage{float}
\usepackage{graphicx}
\usepackage{geometry}
\geometry{margin=1.5cm}

% FIX 2: adjustbox for table width clamping in two-column layout
\usepackage{adjustbox}

% --- 3. ENGINE-SPECIFIC UNICODE (XeLaTeX) ---
\usepackage{ifxetex,ifluatex}
\ifxetex
  \usepackage{fontspec}
  \setmainfont{Libertinus Serif}
  \defaultfontfeatures{Ligatures=TeX}
\else
  \usepackage[T1]{fontenc}
  \usepackage[utf8]{inputenc}
\fi

% --- 4. HYPERLINKS & HEADERS ---
\usepackage[unicode=true]{hyperref}
\hypersetup{
    breaklinks=true,
    pdfborder={0 0 0},
    colorlinks=true,
    linkcolor=black,
    citecolor=black,
    urlcolor=black
}

% --- 5. THE "STABILITY BRIDGE" (Table Fix) ---
% Redefines longtable -> tabular, now wrapped in adjustbox so wide tables
% are scaled down to fit the column width instead of overflowing.
\makeatletter
\renewenvironment{longtable}[2][]{%
  \begin{center}
  \small
  \begin{adjustbox}{max width=\linewidth}
  \begin{tabular}{#2}
}{%
  \end{tabular}
  \end{adjustbox}
  \end{center}
}
\renewcommand{\endfirsthead}{}
\renewcommand{\endhead}{}
\renewcommand{\endfoot}{}
\renewcommand{\endlastfoot}{}

\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\makeatother

% --- 6. HEADER LOGIC ---
\title{\textbf{$title$}}
\author{
$for(author)$
  $author.name$ \\
  \small $author.affiliation$ \\
  \small \texttt{$author.email$} $sep$ \and
$endfor$
}
\date{$date$}

\begin{document}

\twocolumn[
  \begin{@twocolumnfalse}
    \maketitle
    $if(abstract)$
    \begin{abstract}
      \noindent $abstract$
    \end{abstract}
    \vspace{1.5em}
    $endif$
  \end{@twocolumnfalse}
]

$body$

\end{document}
