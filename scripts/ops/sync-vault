#!/usr/bin/env python3
import os
import re
import sys
import subprocess
from collections import Counter
from datetime import datetime

# Single Source of Truth for the vault location
VAULT_PATH = os.getenv("VAULT_DIR", os.path.expanduser("~/Documents/my-cs-notes"))


def run_git(commands, cwd):
    try:
        subprocess.run(
            ["git"] + commands, cwd=cwd, check=True, capture_output=True, text=True
        )
    except subprocess.CalledProcessError as e:
        print(f"❌ Git Transaction Error ({cwd}): {e.stderr.strip()}", file=sys.stderr)
        sys.exit(1)


def sync_path(relative_target, label):
    full_path = os.path.join(VAULT_PATH, relative_target)
    if not os.path.exists(full_path):
        print(f"⚠️ Target structure path not found: {full_path}", file=sys.stderr)
        sys.exit(1)

    print(f"📥 [Librarian] Synchronizing {label}...")
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    # Atomic stage-and-commit sequence
    run_git(["reset"], VAULT_PATH)
    run_git(["add", relative_target], VAULT_PATH)

    # Evaluate changes before pushing to keep a clean commit history
    status_check = subprocess.run(
        ["git", "status", "--porcelain"], cwd=VAULT_PATH, capture_output=True, text=True
    )
    if status_check.stdout.strip():
        run_git(
            [
                "commit",
                "-m",
                f"maintenance({label.lower()}): automated sync update ({timestamp})",
            ],
            VAULT_PATH,
        )
        run_git(["push", "origin", "main"], VAULT_PATH)
        print(f"✅ {label} database synchronized securely.")
    else:
        print(f"ℹ️ No local modifications detected for {label}.")


SR_COMMENT = re.compile(r"<!--SR:[^>]*-->")
DECK_TAG = re.compile(r"#flashcards/(\S+)")


def git_out(args):
    return subprocess.run(
        ["git"] + args, cwd=VAULT_PATH, capture_output=True, text=True, check=True
    ).stdout


def review_only_changes(path):
    """Return the number of changed SR comments if the diff touches nothing else, else None."""
    removed, added, reviews = [], [], 0
    for line in git_out(["diff", "-U0", "HEAD", "--", path]).splitlines():
        if line.startswith(("---", "+++")) or line[:1] not in ("+", "-"):
            continue
        if line[0] == "+":
            reviews += len(SR_COMMENT.findall(line))
        content = SR_COMMENT.sub("", line[1:]).strip()
        if content:
            (added if line[0] == "+" else removed).append(content)
    return reviews if Counter(removed) == Counter(added) else None


def deck_name(path):
    with open(os.path.join(VAULT_PATH, path), encoding="utf-8") as f:
        match = DECK_TAG.search(f.read())
    return match.group(1).split("/")[-1] if match else os.path.dirname(path)


def sync_cards(dry_run=False):
    """Commit review-data changes from every deck in the vault, wherever it lives."""
    print("📥 [Librarian] Collecting flashcard reviews...")
    # -z: NUL-separated raw paths; otherwise git quotes non-ASCII names (e.g. "M\303\266bel")
    changed = git_out(["diff", "-z", "--name-only", "HEAD", "--", "*.md"]).split("\0")[:-1]
    synced, skipped, per_deck = [], [], Counter()
    for path in changed:
        reviews = review_only_changes(path)
        if reviews is None:
            if SR_COMMENT.search(git_out(["diff", "HEAD", "--", path])):
                skipped.append(path)
            continue
        synced.append(path)
        per_deck[deck_name(path)] += reviews

    for path in skipped:
        print(f"⏭️  Skipped (has non-review edits, commit it yourself): {path}")
    if not synced:
        print("ℹ️ No new reviews detected.")
        return

    summary = ", ".join(f"{deck} {n}" for deck, n in per_deck.most_common())
    print(f"🃏 {sum(per_deck.values())} reviews across {len(synced)} files: {summary}")
    if dry_run:
        print("\n".join(f"   {p}" for p in synced))
        return

    date = datetime.now().strftime("%Y-%m-%d")
    # Committing explicit paths leaves anything else in the index untouched
    run_git(
        ["commit", "-m", f"maintenance(cards): reviews {date} ({summary})", "--", *synced],
        VAULT_PATH,
    )
    run_git(["push", "origin", "main"], VAULT_PATH)
    print("✅ Cards synchronized.")


def generate_structure_map():
    print("🌲 [Librarian] Mapping Knowledge Base structure tree...")
    try:
        output_file_name = "vault_structure.txt"
        output_file = os.path.join(VAULT_PATH, output_file_name)

        with open(output_file, "w") as f:
            if (
                subprocess.run(
                    ["command", "-v", "lsd"], shell=True, stdout=subprocess.DEVNULL
                ).returncode
                == 0
            ):
                subprocess.run(
                    ["lsd", "--tree", "--depth", "3"], cwd=VAULT_PATH, stdout=f
                )
            else:
                subprocess.run(["tree", "-L", "3"], cwd=VAULT_PATH, stdout=f)

        print(f"✅ Vault structure map written to {output_file}")

        # Automatically sync the generated map file
        sync_path(output_file_name, "Vault-Tree-Map")

    except Exception as e:
        print(f"❌ Error compiling tree index map: {e}", file=sys.stderr)


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(
            "Usage: sync-vault --cards [-n] | --gerlog | --dsalog | --vtree", file=sys.stderr
        )
        sys.exit(1)

    flag = sys.argv[1]
    if flag == "--cards":
        sync_cards(dry_run="-n" in sys.argv[2:])
    elif flag == "--gerlog":
        sync_path("40_Natural_Languages/German/99_Daily_Output", "German-Practice-Log")
    elif flag == "--dsalog":
        sync_path(
            "05_Algorithms_and_Data_Structures/03_Practice_Log/99_Daily_Output/01_Practice_Logs",
            "DSA-Log",
        )
    elif flag == "--vtree":
        generate_structure_map()
    else:
        print(f"❌ Invalid flag operational parameter: {flag}", file=sys.stderr)
        sys.exit(1)
