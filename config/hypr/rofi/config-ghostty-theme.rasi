/* Ghostty themes — scripts/wm/Ghostty_themes.sh
 * Layout only: colors, fonts and shapes come from themes/Lagos.rasi (via config.rasi). */
@import "~/.config/hypr/rofi/config.rasi"

entry { placeholder: "Choose a Ghostty theme · Enter applies"; }

listview {
  columns: 2;
  lines:   9;
}

element { spacing: 0; }
element-icon { size: 0; }
element-text { horizontal-align: 0.0; }
