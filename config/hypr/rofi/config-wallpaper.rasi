/* Wallpaper picker — scripts/wm/WallpaperSelect.sh, HyprlockWallpaperSelect.sh
 * Layout only: colors, fonts and shapes come from themes/Lagos.rasi (via config.rasi). */
@import "~/.config/hypr/rofi/config.rasi"

window  { width: 960px; }
mainbox { children: [ "inputbar", "listview" ]; }
entry   { placeholder: "Search wallpapers"; }

/* A grid of thumbnails, names below them */
listview {
  columns:      5;
  lines:        2;
  flow:         horizontal;
  fixed-height: true;
  spacing:      8px;
}
element {
  orientation:   vertical;
  padding:       8px;
  spacing:       6px;
  border-radius: 14px;
}
element-icon {
  size:          150px;
  border-radius: 10px;
  horizontal-align: 0.5;
}
element-text {
  horizontal-align: 0.5;
  font: "Inter 9";
}
