/* Keybinds — scripts/wm/KeyHelp.sh (SUPER H; SUPER SHIFT H searches)
 * Layout only: colors, fonts and shapes come from themes/Lagos.rasi (via config.rasi). */
@import "~/.config/hypr/rofi/config.rasi"
/* Colors of the "keybinds" launchers (written by the panel, services/LauncherTheme.qml) */
@import "~/.config/lagos/rofi/keybinds.rasi"

entry { placeholder: "Search keybinds"; }

listview {
  columns: 1;
  lines:   11;
}

element { spacing: 0; }
element-icon { size: 0; }
element-text { horizontal-align: 0.0; }

/* A long list: as tall as the room below the panel's card, never more
 * (lagos-room, written by the panel: services/LauncherTheme.qml) */
window { height: @lagos-room; }
