/* Animations — scripts/wm/Animations.sh
 * Layout only: colors, fonts and shapes come from themes/Lagos.rasi (via config.rasi). */
@import "~/.config/hypr/rofi/config.rasi"
/* Colors of the "other" launchers (written by the panel, services/LauncherTheme.qml) */
@import "~/.config/lagos/rofi/other.rasi"

entry { placeholder: "Search animations"; }

listview {
  columns: 1;
  lines:   9;
}

element { spacing: 0; }
element-icon { size: 0; }
element-text { horizontal-align: 0.0; }
