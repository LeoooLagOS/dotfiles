# Ignore sensitive Git files
.gitconfig_local
credentials
*.p12
*.pem

# Ignore OS/Environment junk
.DS_Store
.env
.direnv/
node_modules/
.initial_startup_done

#ignore Wallpapers 
config/hypr/rofi/.current_wallpaper*
config/hypr/wallpaper_effects/*
config/hypr/rofi/wallust/colors-rofi.rasi
config/hypr/wallust/wallust-hyprland.conf
config/kitty/kitty-themes/01-Wallust.conf
config/waybar/wallust/colors-waybar.css
config/hypr/workspaces.conf
config/hypr/UserConfigs/workspaces.lua

# Machine-specific display layout (templates: *.example)
config/hypr/monitors.conf
config/hypr/monitors.lua
config/hypr/UserConfigs/monitors.lua

# Local overrides and secrets that must never reach the public repo
*.local
*.local.zsh
*.local.lua
.env.*
.ssh/
*.key
*.gpg
*_history
.zsh_history

# Python bytecode
__pycache__/
*.pyc

# Personal data the panel and its scripts keep outside the repo (~/.config/lagos,
# ~/.local/state/quickshell-panel, ~/.cache/quickshell-panel). Listed here too in
# case a copy lands in the tree: calendars, Teams assignments, to-dos, settings,
# tokens and logs never belong in this public repo.
*.ics
todo.json
panel-settings.json
assignments.json
graph-token.json
teams-assignments.json
vault.json
*.jsonl
