# Ignore sensitive Git files
.gitconfig_local
credentials
*.p12
*.pem

# Ignore OS/Environment junk
.DS_Store
.env
.direnv/
node_modules/
.initial_startup_done

#ignore Wallpapers 
config/hypr/rofi/.current_wallpaper*
config/hypr/wallpaper_effects/*
config/hypr/rofi/wallust/colors-rofi.rasi
config/hypr/wallust/wallust-hyprland.conf
config/kitty/kitty-themes/01-Wallust.conf
config/hypr/workspaces.conf
config/hypr/UserConfigs/workspaces.lua

# Machine-specific display layout (templates: *.example)
config/hypr/monitors.conf
config/hypr/monitors.lua
config/hypr/UserConfigs/monitors.lua

# Local overrides and secrets that must never reach the public repo
*.local
*.local.zsh
*.local.lua
.env.*
.ssh/
*.key
*.gpg
*_history
.zsh_history

# Python bytecode
__pycache__/
*.pyc
